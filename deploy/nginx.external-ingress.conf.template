worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    upstream netbox_sync { server unix:/run/netbox-sync-http/api.sock; }
    server {
        listen 127.0.0.1:8081;
        location = /health { return 200 "ready\n"; }
        location / { return 404; }
    }
    server {
        listen unix:/run/netbox-sync-ingress/upstream.sock;
        server_name ${NETBOX_SYNC_PUBLIC_HOST};
        if ($http_host != "${NETBOX_SYNC_PUBLIC_HOST}") { return 421; }
        if ($http_x_forwarded_proto != "https") { return 403; }
        location / {
            proxy_pass http://netbox_sync;
            proxy_http_version 1.1;
            proxy_set_header Host ${NETBOX_SYNC_PUBLIC_HOST};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header Forwarded "";
            proxy_set_header Connection "";
            proxy_connect_timeout 3s;
            proxy_send_timeout 30s;
            proxy_read_timeout 360s;
            proxy_next_upstream off;
            proxy_buffering off;
        }
    }
}
