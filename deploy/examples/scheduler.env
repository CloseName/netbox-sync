SYNC_MODE=apply
SOURCE_CONFIG_MODE=registry-all
APPLY_SCOPE=full
APPLY_CONFIRM=FULL_WRITE
NETBOX_SYNC_REGISTRY_DSN=
NETBOX_SYNC_RUN_WRITER_DSN=
NETBOX_SYNC_REGISTRY_SCHEMA=netbox_sync
NETBOX_SYNC_SOURCE_SECRET_DIR=/run/secrets/netbox-sync-sources
NB_API_URL=
NB_APPLY_API_TOKEN_FILE=/run/secrets/netbox/apply-token
NETBOX_SYNC_NETBOX_CONFIG_FILE=/run/secrets/netbox/bootstrap.json
