worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 30s;
    upstream netbox_sync { server unix:/run/netbox-sync-http/api.sock; }
    server {
        listen 127.0.0.1:8081;
        location = /health { return 200 "ready\n"; }
        location / { return 404; }
    }
    server {
        listen 8080 default_server;
        server_name _;
        if ($host != "${NETBOX_SYNC_PUBLIC_HOST}") { return 421; }
        return 308 https://${NETBOX_SYNC_PUBLIC_HOST}$request_uri;
    }
    server {
        listen 8443 ssl default_server;
        server_name ${NETBOX_SYNC_PUBLIC_HOST};
        ssl_certificate /run/netbox-sync-tls/ssl.crt;
        ssl_certificate_key /run/netbox-sync-tls/ssl.key;
        ssl_dhparam /run/netbox-sync-tls/dhparam.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 1h;
        ssl_session_tickets off;
        if ($host != "${NETBOX_SYNC_PUBLIC_HOST}") { return 421; }
        add_header Strict-Transport-Security "max-age=31536000" always;
        location / {
            proxy_pass http://netbox_sync;
            proxy_http_version 1.1;
            proxy_set_header Host ${NETBOX_SYNC_PUBLIC_HOST};
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header Forwarded "";
            proxy_set_header Connection "";
            proxy_connect_timeout 3s;
            proxy_send_timeout 30s;
            proxy_read_timeout 360s;
            proxy_next_upstream off;
            proxy_buffering off;
        }
    }
}
