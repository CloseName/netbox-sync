FROM node:24-alpine AS frontend
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
COPY netbox_sync/public_errors.json /netbox_sync/public_errors.json
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE.txt requirements-migrations.txt alembic.ini ./
COPY netbox_sync ./netbox_sync
COPY migrations ./migrations
RUN pip install --no-cache-dir '.[web]' -r requirements-migrations.txt \
    && useradd --uid 10001 --create-home netbox-sync
COPY --from=frontend /web/dist /app/web
ENV NETBOX_SYNC_WEB_DIST=/app/web PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "netbox_sync.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
