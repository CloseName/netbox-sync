# Disposable operator-host harness, never an application service/image.
FROM docker:28-cli AS cli
FROM debian:12
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv openssl ca-certificates tar util-linux systemd dbus \
    && rm -rf /var/lib/apt/lists/*
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
ENV PYTHONDONTWRITEBYTECODE=1
CMD ["sleep", "infinity"]
