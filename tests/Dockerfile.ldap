# Protocol-only fixture: LDAP and test client run on loopback with --network none.
ARG TEST_IMAGE=netbox-sync-auth-tests:review
FROM ${TEST_IMAGE}
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends slapd ldap-utils openssl && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'ldap3>=2.9.1,<3'
